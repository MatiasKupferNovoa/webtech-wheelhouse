<%= form_with model: service do |f| %>
  <% if service.errors.any? %>
    <div class="alert alert-danger">
      <%= service.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <div class="mb-3">
    <%= f.label :name, class: "form-label" %>
    <%= f.text_field :name, class: ["form-control", { "is-invalid": service.errors[:name].any? }] %>
    <% if service.errors[:name].any? %>
      <div class="invalid-feedback">
        <%= service.errors.full_messages_for(:name).to_sentence %>
      </div>
    <% end %>
  </div>

  <div class="mb-3">
    <%= f.label :current_price, class: "form-label" %>
    <%= f.number_field :current_price, step: "0.01", class: ["form-control", { "is-invalid": service.errors[:current_price].any? }] %>
    <% if service.errors[:current_price].any? %>
      <div class="invalid-feedback">
        <%= service.errors.full_messages_for(:current_price).to_sentence %>
      </div>
    <% end %>
  </div>

  <%= f.submit class: "btn btn-primary" %>
<% end %>