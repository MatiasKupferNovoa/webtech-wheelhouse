<%= form_with model: repair do |f| %>
  <% if repair.errors.any? %>
    <div class="alert alert-danger">
      <%= repair.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <div class="mb-3">
    <%= f.label :bike_id, "Bike", class: "form-label" %>
    <%= f.collection_select :bike_id, Bike.by_brand, :id, :display_name,
                            { prompt: "Choose a bike" },
                            { class: ["form-select", { "is-invalid": repair.errors[:bike_id].any? || repair.errors[:bike].any? }] } %>
    <% if repair.errors[:bike_id].any? || repair.errors[:bike].any? %>
      <div class="invalid-feedback">
        <%= (repair.errors.full_messages_for(:bike_id) + repair.errors.full_messages_for(:bike)).to_sentence %>
      </div>
    <% end %>
  </div>

  <div class="mb-3">
    <%= f.label :staff_id, "Mechanic", class: "form-label" %>
    <%= f.collection_select :staff_id, Staff.where(role: "mechanic").by_name, :id, :name,
                            { include_blank: "Not assigned" },
                            { class: ["form-select", { "is-invalid": repair.errors[:staff_id].any? || repair.errors[:staff].any? }] } %>
    <% if repair.errors[:staff_id].any? || repair.errors[:staff].any? %>
      <div class="invalid-feedback">
        <%= (repair.errors.full_messages_for(:staff_id) + repair.errors.full_messages_for(:staff)).to_sentence %>
      </div>
    <% end %>
  </div>

  <div class="mb-3">
    <%= f.label :received_at, class: "form-label" %>
    <%= f.datetime_local_field :received_at, class: ["form-control", { "is-invalid": repair.errors[:received_at].any? }] %>
    <% if repair.errors[:received_at].any? %>
      <div class="invalid-feedback">
        <%= repair.errors.full_messages_for(:received_at).to_sentence %>
      </div>
    <% end %>
  </div>

  <div class="mb-3">
    <%= f.label :promised_on, class: "form-label" %>
    <%= f.date_field :promised_on, class: ["form-control", { "is-invalid": repair.errors[:promised_on].any? }] %>
    <% if repair.errors[:promised_on].any? %>
      <div class="invalid-feedback">
        <%= repair.errors.full_messages_for(:promised_on).to_sentence %>
      </div>
    <% end %>
  </div>

  <div class="mb-3">
    <%= f.label :approval_status, class: "form-label" %>
    <%= f.text_field :approval_status, class: ["form-control", { "is-invalid": repair.errors[:approval_status].any? }] %>
    <% if repair.errors[:approval_status].any? %>
      <div class="invalid-feedback">
        <%= repair.errors.full_messages_for(:approval_status).to_sentence %>
      </div>
    <% end %>
  </div>

  <div class="mb-3">
    <%= f.label :status, class: "form-label" %>
    <%= f.select :status, Repair.statuses.keys, {},
                 class: ["form-select", { "is-invalid": repair.errors[:status].any? }] %>
    <% if repair.errors[:status].any? %>
      <div class="invalid-feedback">
        <%= repair.errors.full_messages_for(:status).to_sentence %>
      </div>
    <% end %>
  </div>

  <div class="mb-3">
    <%= f.label :ready_at, class: "form-label" %>
    <%= f.datetime_local_field :ready_at, class: ["form-control", { "is-invalid": repair.errors[:ready_at].any? }] %>
    <% if repair.errors[:ready_at].any? %>
      <div class="invalid-feedback">
        <%= repair.errors.full_messages_for(:ready_at).to_sentence %>
      </div>
    <% end %>
  </div>

  <div class="mb-3">
    <%= f.label :picked_up_at, class: "form-label" %>
    <%= f.datetime_local_field :picked_up_at, class: ["form-control", { "is-invalid": repair.errors[:picked_up_at].any? }] %>
    <% if repair.errors[:picked_up_at].any? %>
      <div class="invalid-feedback">
        <%= repair.errors.full_messages_for(:picked_up_at).to_sentence %>
      </div>
    <% end %>
  </div>

  <% services = Service.by_name.load %>

  <%= f.fields_for :repair_services do |line| %>
    <div class="mb-3">
      <% if line.object.errors.any? %>
        <div class="alert alert-danger">
          <%= line.object.errors.full_messages.to_sentence %>
        </div>
      <% end %>

      <%= line.label :service_id, "Service #{line.index.to_i + 1}", class: "form-label" %>
      <%= line.collection_select :service_id, services, :id, :name,
                                 { include_blank: "Choose a service" },
                                 { class: ["form-select", { "is-invalid": line.object.errors[:service_id].any? || line.object.errors[:service].any? }] } %>
      <% if line.object.errors[:service_id].any? || line.object.errors[:service].any? %>
        <div class="invalid-feedback">
          <%= (line.object.errors.full_messages_for(:service_id) + line.object.errors.full_messages_for(:service)).to_sentence %>
        </div>
      <% end %>

      <%= line.label :price_charged, class: "form-label mt-3" %>
      <%= line.number_field :price_charged, step: "0.01",
                            class: ["form-control", { "is-invalid": line.object.errors[:price_charged].any? }] %>
      <% if line.object.errors[:price_charged].any? %>
        <div class="invalid-feedback">
          <%= line.object.errors.full_messages_for(:price_charged).to_sentence %>
        </div>
      <% end %>

      <% if line.object.persisted? %>
        <div class="form-check">
          <%= line.check_box :_destroy, class: "form-check-input" %>
          <%= line.label :_destroy, "Remove service", class: "form-check-label" %>
        </div>
      <% end %>
    </div>
  <% end %>

  <%= f.submit class: "btn btn-primary" %>
<% end %>