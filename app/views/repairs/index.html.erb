<h1>Repairs</h1>

<%= link_to "New repair", new_repair_path, class: "btn btn-primary mb-3" %>

<p>
  Browse repair jobs. Overdue repairs that have not been picked up
  are highlighted in red.
</p>

<% if @repairs.empty? %>
  <p class="text-muted">No repairs registered.</p>
<% else %>
  <div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
      <thead class="table-dark">
        <tr>
          <th>Photo</th>
          <th scope="col">Repair</th>
          <th scope="col">Bike</th>
          <th scope="col">Customer</th>
          <th scope="col">Status</th>
          <th scope="col">Promised date</th>
          <th>Diagnosis</th>
        </tr>
      </thead>

      <tbody>
        <%= render @repairs %>
      </tbody>
    </table>
  </div>
<% end %>