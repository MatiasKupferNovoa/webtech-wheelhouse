<tr class="<%= 'table-danger' if repair.overdue? %>">
  <td>
    <% if repair.intake_photos.attached? %>
      <%= image_tag repair.intake_photos.first.variant(:thumb),
                    alt: "#{repair.bike.brand} #{repair.bike.model}, Repair ##{repair.id}" %>
    <% else %>
      No photo
    <% end %>
  </td>
  <td>
    <%= link_to repair.id, repair_path(repair) %>
  </td>
  <td>
    <%= link_to "#{repair.bike.brand} #{repair.bike.model} (#{repair.bike.serial_number})",
                bike_path(repair.bike) %>
  </td>
  <td>
    <%= link_to repair.bike.customer.name,
                customer_path(repair.bike.customer) %>
  </td>
  <td><%= repair.status %></td>
  <td>
    <% if repair.promised_on %>
      <%= l(repair.promised_on, format: :long) %>
    <% else %>
      Not scheduled
    <% end %>
  </td>
  
  <td class="text-nowrap">
    <% if repair.diagnosis.present? %>
      <%= truncate(repair.diagnosis.to_plain_text.squish, length: 80) %>
    <% else %>
      No diagnosis
    <% end %>
  </td>
</tr>