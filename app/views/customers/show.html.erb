<% content_for :title, @customer.name %>

<div class="card">
  <div class="card-body">
    <h1 class="card-title h4"><%= @customer.name %></h1>

    <p class="card-text">
      Phone: <%= @customer.phone %>
    </p>
  </div>
</div>

<h2 class="h5 mt-4">Bikes</h2>

<%= link_to "New bike", new_bike_path(customer_id: @customer.id), class: "btn btn-primary mb-3" %>

<% if @bikes.empty? %>
  <p class="text-muted">This customer has no bikes registered.</p>
<% else %>
  <div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
      <thead class="table-dark">
        <tr>
          <th scope="col">Serial number</th>
          <th scope="col">Brand</th>
          <th scope="col">Model</th>
          <th scope="col">Color</th>
          <th scope="col">Customer</th>
        </tr>
      </thead>

      <tbody>
        <%= render @bikes %>
      </tbody>
    </table>
  </div>
<% end %>

<%= link_to "All customers", customers_path, class: "btn btn-outline-secondary mt-3" %>

<%= link_to "Edit customer", edit_customer_path(@customer), class: "btn btn-outline-primary mt-3" %>

<%= button_to "Delete customer", customer_path(@customer), method: :delete,
    form: { data: { turbo_confirm: "Delete customer #{@customer.name}?" } },
    class: "btn btn-outline-danger mt-3" %>