<% content_for :title, @customer.name %>

<div class="card">
  <div class="card-body">
    <h1 class="card-title h4"><%= @customer.name %></h1>

    <p class="card-text">
      Phone: <%= @customer.phone %>
    </p>
  </div>
</div>

<h2 class="h5 mt-4">Bikes</h2>

<% if @customer.bikes.empty? %>
  <p class="text-muted">This customer has no bikes registered.</p>
<% else %>
  <div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
      <thead class="table-dark">
        <tr>
          <th scope="col">Serial number</th>
          <th scope="col">Brand</th>
          <th scope="col">Model</th>
          <th scope="col">Color</th>
          <th scope="col">Customer</th>
        </tr>
      </thead>

      <tbody>
        <%= render @customer.bikes %>
      </tbody>
    </table>
  </div>
<% end %>

<%= link_to "All customers", customers_path,
            class: "btn btn-outline-secondary mt-3" %>