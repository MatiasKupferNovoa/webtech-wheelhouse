<%= form_with model: customer do |f| %>
  <% if customer.errors.any? %>
    <div class="alert alert-danger">
      <%= customer.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <div class="mb-3">
    <%= f.label :name, class: "form-label" %>
    <%= f.text_field :name,
          class: ["form-control", { "is-invalid": customer.errors[:name].any? }] %>
    <% if customer.errors[:name].any? %>
      <div class="invalid-feedback">
        <%= customer.errors.full_messages_for(:name).to_sentence %>
      </div>
    <% end %>
  </div>

  <div class="mb-3">
    <%= f.label :phone, class: "form-label" %>
    <%= f.text_field :phone,
          class: ["form-control", { "is-invalid": customer.errors[:phone].any? }] %>
    <% if customer.errors[:phone].any? %>
      <div class="invalid-feedback">
        <%= customer.errors.full_messages_for(:phone).to_sentence %>
      </div>
    <% end %>
  </div>

  <%= f.submit class: "btn btn-primary" %>
<% end %>