<%= form_with model: staff do |f| %>
  <% if staff.errors.any? %>
    <div class="alert alert-danger">
      <%= staff.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <div class="mb-3">
    <%= f.label :name, class: "form-label" %>
    <%= f.text_field :name, class: ["form-control", { "is-invalid": staff.errors[:name].any? }] %>
    <% if staff.errors[:name].any? %>
      <div class="invalid-feedback">
        <%= staff.errors.full_messages_for(:name).to_sentence %>
      </div>
    <% end %>
  </div>

  <div class="mb-3">
    <%= f.label :role, class: "form-label" %>
    <%= f.text_field :role, class: ["form-control", { "is-invalid": staff.errors[:role].any? }] %>
    <% if staff.errors[:role].any? %>
      <div class="invalid-feedback">
        <%= staff.errors.full_messages_for(:role).to_sentence %>
      </div>
    <% end %>
  </div>

  <%= f.submit class: "btn btn-primary" %>
<% end %>