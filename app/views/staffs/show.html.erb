<% content_for :title, @staff.name %>

<h1><%= @staff.name %></h1>
<p>Role: <%= @staff.role %></p>

<h2>Repairs</h2>

<% if @repairs.empty? %>
  <p>No repairs assigned.</p>
<% else %>
  <div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
      <thead class="table-dark">
        <tr>
          <th scope="col">Repair</th>
          <th scope="col">Bike</th>
          <th scope="col">Customer</th>
          <th scope="col">Status</th>
          <th scope="col">Promised date</th>
        </tr>
      </thead>
      <tbody>
        <%= render @repairs %>
      </tbody>
    </table>
  </div>
<% end %>

<%= link_to "All staff", staffs_path, class: "btn btn-outline-secondary mt-3" %>

<%= link_to "Edit staff member", edit_staff_path(@staff), class: "btn btn-outline-primary mt-3" %>

<%= button_to "Delete staff member", staff_path(@staff), method: :delete,
    form: { data: { turbo_confirm: "Delete staff member #{@staff.name}?" } },
    class: "btn btn-outline-danger mt-3" %>